# Recall API key. This app talks to the us-west-2 (pay as you go) region; change BASE_URL in app/recall.py if yours differs.
RECALL_API_KEY=

# Workspace verification secret from Recall > Developers > API keys, starts with whsec_.
# Legacy workspaces (created before 2025-12-15) use the per endpoint Svix secret from the webhooks dashboard instead.
RECALL_WEBHOOK_SECRET=

# Public https URL of this app with no trailing slash, e.g. a static ngrok domain.
# TODO(Shawn): in the Recall webhooks dashboard add PUBLIC_URL/webhooks/recall as an endpoint,
# subscribed to the bot.* status events plus recording.done and transcript.done. Real-time transcript
# events need no dashboard setup; they go to PUBLIC_URL/rt/?token=RT_TOKEN straight from the create bot call.
PUBLIC_URL=https://your-subdomain.ngrok.app

# Any random string. Recall posts live transcript events to PUBLIC_URL/rt/?token=RT_TOKEN; other tokens get 401.
RT_TOKEN=change-me

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Live commitments at or above this confidence show as proposed; below it (down to 0.5) they show as unsure.
# After the call, confirmed commitments at or above it are sent automatically; everything else waits for a rep.
CONFIDENCE_THRESHOLD=0.8

# 1 skips the model (a regex stub stands in) and prints Slack messages instead of sending them.
DRY_RUN=0

# Slack incoming webhook URL that follow-ups are posted to.
SLACK_WEBHOOK_URL=
